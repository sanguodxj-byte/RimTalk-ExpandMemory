<Project Sdk="Microsoft.NET.Sdk">
	
	<!-- VS 环境配置 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug17'">
		<GameVersion>1.7</GameVersion>
	</PropertyGroup>
	
	<PropertyGroup>
		<!-- 配置变量 -->
		<GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
		<IsGame17 Condition=" '$(GameVersion)' == '1.7' ">true</IsGame17>
		<!-- RimTalk 本体尚未提供 1.7 目录，1.7 下实际加载的仍是其 1.6 程序集 -->
		<RimTalkGameVersion Condition=" '$(IsGame17)' == 'true' ">1.6</RimTalkGameVersion>
		<RimTalkGameVersion Condition=" '$(RimTalkGameVersion)' == '' ">$(GameVersion)</RimTalkGameVersion>

		<!-- 追加一个当前游戏版本的常量，如“V1_7” -->
		<DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>

		<RimWorldDir Condition=" '$(RimWorldDir)' == '' ">..\RimWorld</RimWorldDir>
		<RimTalkDir Condition=" '$(RimTalkDir)' == '' ">..\..\workshop\content\294100\3551203752</RimTalkDir>

		<ModFolderName>RimTalk-ExpandMemory</ModFolderName>

		<!-- 编程配置项 -->
		<RootNamespace>RimTalk.Memory</RootNamespace>
		<LangVersion>latest</LangVersion>

		<!-- 编译配置项 -->
		<Configurations>Debug;Release;Debug17</Configurations>
		<OutputType>Library</OutputType>
		<!-- 1.7 起游戏换用自定义 CLR（.NET 10），旧版本仍为 .NET Framework 4.8 -->
		<TargetFramework Condition=" '$(IsGame17)' == 'true' ">net10.0</TargetFramework>
		<TargetFramework Condition=" '$(TargetFramework)' == '' ">net48</TargetFramework>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyName>RimTalkMemoryPatch</AssemblyName>

		<!-- 编译项优化 -->
		<UseSharedCompilation>false</UseSharedCompilation>
		<UseHostCompilerIfAvailable>false</UseHostCompilerIfAvailable>
		<Deterministic>false</Deterministic>

		<!-- 输出 -->
		<OutputPath>$(GameVersion)/Assemblies</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- NuGet 包复制到输出目录 -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>false</GenerateDependencyFile>

		<!-- 杂项配置，VS开发的时候没用到过，应该是用于VScode的 -->
		<ProvideCommandLineArgs>false</ProvideCommandLineArgs>
		<LongPathsEnabled>true</LongPathsEnabled>
		<DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
	</PropertyGroup>

	<ItemGroup>
		<!-- NuGet 包引用：1.5/1.6 走 Krafs 参考程序集；1.7 起游戏换用自定义 CLR，直接引用游戏目录的原版程序集 -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" PrivateAssets="All" Condition=" '$(IsGame17)' != 'true' " />
		<PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
		<PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.3.0" PrivateAssets="All" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="All" />

		<!-- 程序集引用 -->
		<Reference Include="RimTalk" Condition="Exists('$(RimTalkDir)\$(RimTalkGameVersion)\Assemblies\RimTalk.dll')">
			<HintPath>$(RimTalkDir)\$(RimTalkGameVersion)\Assemblies\RimTalk.dll</HintPath>
		</Reference>
		<Reference Include="System.Net.Http" Condition=" '$(IsGame17)' != 'true' ">
		</Reference>
		<!-- 1.7 原版程序集（net10.0） -->
		<Reference Include="Assembly-CSharp" Condition=" '$(IsGame17)' == 'true' ">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="UnityStubs" Condition=" '$(IsGame17)' == 'true' ">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
		</Reference>
		<Reference Include="Waylith" Condition=" '$(IsGame17)' == 'true' ">
			<HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
		</Reference>
		<Reference Include="Waylith.UnityCompat" Condition=" '$(IsGame17)' == 'true' ">
			<HintPath>$(RimWorldDir)\Waylith.UnityCompat.dll</HintPath>
		</Reference>
		<Reference Include="RimWorldV17" Condition=" '$(IsGame17)' == 'true' ">
			<HintPath>$(RimWorldDir)\RimWorld.dll</HintPath>
		</Reference>

		<!-- 排除文件 -->
		<Compile Remove="..\RimTalk\**" />
		<Compile Remove="backup\**" />
		<Compile Remove="Backups\**" />
		<Compile Remove="**\*.backup.cs" />
	</ItemGroup>

	<!-- 编译后自动部署 -->
	<Target Name="DeployToModsFolder" AfterTargets="Build" Condition=" '$(AutoDeploy)' == 'true' ">
		<CallTarget Targets="WinDeploy" Condition=" '$(OS)' == 'Windows_NT' " />
	</Target>

	<!-- Deploy to RimWorld client (Windows) -->
	<Target Name="WinDeploy">
		<PropertyGroup>
			<WinModPath>$(RimWorldDir)\Mods\$(ModFolderName)\</WinModPath>
		</PropertyGroup>
		<Message Text="Copying to $(WinModPath)" Importance="high" />
		<MakeDir Directories="$(WinModPath)" />
		<Exec Command="robocopy &quot;$(ProjectDir)About&quot; &quot;$(WinModPath)About&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)Languages&quot; &quot;$(WinModPath)Languages&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)Textures&quot; &quot;$(WinModPath)Textures&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)Resource&quot; &quot;$(WinModPath)Resource&quot; /MIR" IgnoreExitCode="true" />
		<Exec Command="robocopy &quot;$(ProjectDir)$(GameVersion)&quot; &quot;$(WinModPath)$(GameVersion)&quot; /MIR" IgnoreExitCode="true" />
		<Copy SourceFiles="$(ProjectDir)LoadFolders.xml" DestinationFolder="$(WinModPath)" SkipUnchangedFiles="true" />
		<Message Text="--- Windows deployment finished successfully ---" Importance="high" />
	</Target>

</Project>
